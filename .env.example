# ============================================
# Qasim Medicos Frontend - Environment Variables
# ============================================
# Copy this file to ".env" (for local dev) and fill in your values.
# On Vercel, add these in Project Settings → Environment Variables.

# Backend API URL
# IMPORTANT: Do NOT add a trailing slash — the app appends "/api/..." automatically.
# Local dev:    http://localhost:5000
# Production:   https://your-backend-project.vercel.app
VITE_API_URL=http://localhost:5000

# App metadata (optional)
VITE_APP_NAME=Qasim Medicos
VITE_APP_VERSION=1.0.0
